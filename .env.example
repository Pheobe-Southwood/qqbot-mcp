# QQbot-MCP 配置模板。
# CLI 使用：复制到 /etc/qqbot-mcp.env 并 chmod 600。
# MCP 使用：把变量写进客户端的 env 配置。
# 不要提交真实的 AppSecret/token。

# --- 凭据 -------------------------------------------------------------------
QQBOT_APP_ID=
QQBOT_APP_SECRET=
# 可选：直接注入临时 access_token，适合调试，不推荐长期使用。
# QQBOT_ACCESS_TOKEN=

# --- 模式 -------------------------------------------------------------------
# docs = 只查文档；read = 只读接口；write = 发消息/管理。
# 没有凭据时强制 docs。
QQBOT_MCP_MODE=read

# --- API --------------------------------------------------------------------
QQBOT_API_BASE=https://api.bot.qq.com
# QQBOT_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken
QQBOT_MCP_TIMEOUT_MS=30000
QQBOT_MCP_RATE_LIMIT=true

# --- 本地文件 ---------------------------------------------------------------
# 不设置则禁用 file_path 上传；所有路径必须落在这个目录内。
QQBOT_MCP_UPLOAD_ROOT=/srv/qqbot-files
QQBOT_MCP_DOWNLOAD_DIR=/var/lib/qqbot-mcp/downloads
QQBOT_MCP_MAX_UPLOAD_BYTES=209715200

# --- 事件 -------------------------------------------------------------------
# off | websocket | webhook
QQBOT_MCP_EVENT_TRANSPORT=off
QQBOT_MCP_EVENT_AUTOSTART=false
# auto = GROUP_AND_C2C_EVENT, INTERACTION, PUBLIC_GUILD_MESSAGES
QQBOT_MCP_INTENTS=auto
QQBOT_MCP_SHARD=0,1
QQBOT_MCP_EVENT_BUFFER=1000
QQBOT_MCP_EVENT_TTL_MS=1800000

# --- Webhook（仅 transport=webhook） ---------------------------------------
QQBOT_MCP_WEBHOOK_HOST=127.0.0.1
QQBOT_MCP_WEBHOOK_PORT=8787
QQBOT_MCP_WEBHOOK_PATH=/qqbot/webhook

# --- CLI 二维码 -------------------------------------------------------------
# on/off：CLI 启动时是否打印二维码。
QQBOT_MCP_QR=on
# 二维码默认指向 QQ 机器人快速创建/登录入口，可换成自定义邀请链接。
QQBOT_MCP_QR_URL=https://q.qq.com/qqbot/openclaw/login.html?redirect_url=https%3A%2F%2Fq.qq.com%2Fqqbot%2Fopenclaw%2F
# 二维码 PNG 保存目录；留空则使用系统临时目录。
# QQBOT_MCP_QR_DIR=/tmp/qqbot-mcp-qr

# --- 审计 / 日志 ------------------------------------------------------------
# QQBOT_MCP_AUDIT_LOG=/var/log/qqbot-mcp/audit.jsonl
QQBOT_MCP_AUDIT_CONTENT=false
QQBOT_MCP_LOG_LEVEL=info
