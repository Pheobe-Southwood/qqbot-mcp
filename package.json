{
  "name": "qqbot-mcp",
  "version": "0.2.0",
  "description": "把 QQ 官方机器人 OpenAPI 封装成 MCP 服务和中文交互式 CLI。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "qqbot-mcp": "./dist/cli.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "docs",
    "catalog",
    "examples",
    "deploy",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap": "node scripts/bootstrap-sources.mjs",
    "gen": "node scripts/sync-catalog.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke-cli.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "docs:coverage": "node scripts/gen-coverage-doc.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "author": "phoebe-southwood",
  "homepage": "https://github.com/Pheobe-Southwood/qqbot-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pheobe-Southwood/qqbot-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Pheobe-Southwood/qqbot-mcp/issues"
  },
  "keywords": [
    "qqbot",
    "qq-robot",
    "qq",
    "mcp",
    "model-context-protocol",
    "cli",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
